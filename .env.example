# Copy to .env.local (gitignored). See README, "Strava setup".
# Jay's API application (strava.com/settings/api, logged in as Jay)
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Michelle's own API application, logged in as Michelle. Strava lets a new app connect only its owner,
# so each of you needs one. These override the shared values above for Michelle.
STRAVA_CLIENT_ID_MICHELLE=
STRAVA_CLIENT_SECRET_MICHELLE=
# These two get written by scripts/strava-auth.py; you don't fill them in by hand.
STRAVA_REFRESH_TOKEN_JAY=
STRAVA_REFRESH_TOKEN_MICHELLE=
